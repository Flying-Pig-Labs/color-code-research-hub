# Authentication Configuration
# Set to 'true' to enable safe mode - shows banner instead of redirecting
# This prevents redirect loops and allows manual re-authentication
VITE_AUTH_SAFE_MODE=false

# Disable authentication entirely (development only)
VITE_AUTH_DISABLED=false

# Cognito Configuration
VITE_COGNITO_DOMAIN=your-cognito-domain
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000

# API Configuration  
VITE_API_BASE_URL=https://g5rpch8h1l.execute-api.us-east-1.amazonaws.com/prod
VITE_API_GATEWAY_URL=https://g5rpch8h1l.execute-api.us-east-1.amazonaws.com/prod
# Environment Configuration Template
# Copy this file to .env.local and update if needed
# DO NOT commit .env.local to version control

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_API_KEY=
VITE_WEBHOOK_URL=

# Application Configuration
VITE_PORT=3000
VITE_ENABLE_HEALTH_CHECK=true

# Development Configuration
VITE_API_TIMEOUT=300000  # 5 minutes in milliseconds
VITE_POLL_INTERVAL=2000  # 2 seconds for status polling
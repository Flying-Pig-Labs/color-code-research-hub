{
  "teams": {
    "red": {
      "name": "Red Team - Market Disruption Analysis",
      "description": "Identify vulnerabilities and market opportunities for disruption",
      "basePrompt": "You are analyzing {companyName} for market disruption opportunities with a {disruptionTimeline} month timeline.",
      "defaultConfig": {
        "teamType": "red",
        "analysisFocus": ["revenue_unbundling"],
        "marketScope": "global",
        "disruptionTimeline": 12,
        "investmentRange": ["medium"],
        "targetMarketSize": ["hundred_million"],
        "competitiveIntensity": "medium_competition",
        "customKeywords": []
      },
      "requiredFields": ["companyName", "analysisFocus", "marketScope"],
      "optionalFields": ["disruptionTimeline", "investmentRange", "targetMarketSize", "competitiveIntensity", "customKeywords", "industryVerticals", "disruptionStrategy"]
    },
    "black": {
      "name": "Black Team - Internal Tool Replacement",
      "description": "Explore replacing third-party tools with internal solutions",
      "basePrompt": "Analyze opportunities to replace external tools at {companyName} with internal solutions considering {implementationComplexity} complexity.",
      "defaultConfig": {
        "teamType": "black",
        "toolCategories": ["analytics_monitoring"],
        "informationSources": {
          "Public Documentation": true,
          "User Reviews": true,
          "Competitor Analysis": false,
          "Technical Specs": true,
          "Pricing Information": true
        },
        "implementationComplexity": "medium",
        "teamSizeConstraint": "medium",
        "techStackPreference": [],
        "costComparisonBaseline": "current_tool",
        "evidenceThreshold": 3
      },
      "requiredFields": ["toolCategories", "implementationComplexity"],
      "optionalFields": ["informationSources", "teamSizeConstraint", "techStackPreference", "costComparisonBaseline", "customCostThreshold", "evidenceThreshold", "existingTools", "timeToMarket"]
    },
    "white": {
      "name": "White Team - Whitespace Discovery", 
      "description": "Discover untapped market opportunities and new product spaces",
      "basePrompt": "Discover whitespace opportunities around {companyName} focusing on {opportunityTypes} with {marketEntrySpeed} market entry.",
      "defaultConfig": {
        "teamType": "white",
        "opportunityTypes": ["integration_gaps"],
        "targetCustomerSize": ["enterprise"],
        "businessModelPreference": ["saas_subscription"],
        "technicalApproach": "api_first",
        "marketEntrySpeed": "medium",
        "competitiveLandscape": "medium_competition",
        "successMetrics": ["revenue", "users"],
        "riskTolerance": 3,
        "minimumOpportunitySize": "10m"
      },
      "requiredFields": ["opportunityTypes"],
      "optionalFields": ["targetCustomerSize", "businessModelPreference", "technicalApproach", "marketEntrySpeed", "competitiveLandscape", "successMetrics", "riskTolerance", "minimumOpportunitySize", "ecosystemIntegration", "customSearchAreas"]
    }
  },
  "commonSettings": {
    "maxAgents": 8,
    "defaultTimeout": 3600,
    "outputFormat": "structured_report",
    "githubIntegration": true,
    "slackNotifications": false
  }
}
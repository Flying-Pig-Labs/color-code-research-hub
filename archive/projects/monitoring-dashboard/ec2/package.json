{
  "name": "claude-flow-monitoring-dashboard",
  "version": "1.0.0",
  "description": "Monitoring dashboard for Claude Flow remote execution system",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "node scripts/db-migrate.js",
    "monitoring:start": "npm run build && npm start",
    "docker:build": "docker build -t claude-flow-monitoring .",
    "docker:run": "docker run -p 3001:3001 --env-file .env claude-flow-monitoring"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "rate-limiter-flexible": "^2.4.1",
    "sqlite3": "^5.1.6",
    "redis": "^4.6.7",
    "winston": "^3.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "express-session": "^1.17.3",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/node": "^20.4.5",
    "@types/jest": "^29.5.3",
    "typescript": "^5.1.6",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "eslint": "^8.45.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Claude Flow Team",
  "license": "MIT"
}
# Claude Flow Monitoring Dashboard Configuration

# API Configuration
MONITORING_PORT=3001
MONITORING_HOST=0.0.0.0
API_KEY=your-secure-api-key-here

# Claude Flow Integration
CLAUDE_FLOW_HOST=localhost
CLAUDE_FLOW_PORT=8080
CLAUDE_FLOW_API_KEY=

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./data/db/monitoring.db
DB_RETENTION_DAYS=30

# Redis Configuration (if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your-session-secret-here

# Performance
CACHE_TTL=60
MAX_PAYLOAD_SIZE=10mb
COMPRESSION_LEVEL=6
WORKER_THREADS=4

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL=5000
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/monitoring.log
LOG_MAX_SIZE=10mb
LOG_MAX_FILES=5

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_SSE_URL=http://localhost:3001/api/stream
REACT_APP_POLLING_INTERVAL=5000
REACT_APP_THEME=light